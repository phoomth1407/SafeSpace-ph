# SafeSpace frontend configuration
# Copy this file to .env.local for local development.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# AI provider secrets MUST NOT be placed in this file.
# Configure them in Supabase Edge Function secrets instead:
# OPENAI_API_KEY=...
# OPENAI_MODEL=...
# GEMINI_API_KEY=...
