{
  "name": "GuestAssessment",
  "type": "object",
  "properties": {
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high",
        "severe"
      ],
      "description": "\u0e23\u0e30\u0e14\u0e31\u0e1a\u0e04\u0e27\u0e32\u0e21\u0e40\u0e2a\u0e35\u0e48\u0e22\u0e07\u0e17\u0e35\u0e48 AI \u0e27\u0e34\u0e40\u0e04\u0e23\u0e32\u0e30\u0e2b\u0e4c\u0e44\u0e14\u0e49"
    },
    "risk_score": {
      "type": "number",
      "description": "\u0e04\u0e30\u0e41\u0e19\u0e19\u0e04\u0e27\u0e32\u0e21\u0e40\u0e2a\u0e35\u0e48\u0e22\u0e07 0-100 \u0e17\u0e35\u0e48 AI \u0e27\u0e34\u0e40\u0e04\u0e23\u0e32\u0e30\u0e2b\u0e4c\u0e42\u0e14\u0e22\u0e2d\u0e49\u0e32\u0e07\u0e2d\u0e34\u0e07\u0e07\u0e32\u0e19\u0e27\u0e34\u0e08\u0e31\u0e22"
    },
    "depression_chance": {
      "type": "string",
      "description": "\u0e42\u0e2d\u0e01\u0e32\u0e2a\u0e40\u0e1b\u0e47\u0e19\u0e0b\u0e36\u0e21\u0e40\u0e28\u0e23\u0e49\u0e32\u0e17\u0e35\u0e48 AI \u0e1b\u0e23\u0e30\u0e40\u0e21\u0e34\u0e19"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        }
      },
      "description": "\u0e04\u0e33\u0e15\u0e2d\u0e1a\u0e41\u0e1a\u0e1a\u0e1b\u0e23\u0e30\u0e40\u0e21\u0e34\u0e19\u0e41\u0e15\u0e48\u0e25\u0e30\u0e02\u0e49\u0e2d"
    },
    "ai_summary": {
      "type": "string",
      "description": "\u0e2a\u0e23\u0e38\u0e1b\u0e1c\u0e25\u0e01\u0e32\u0e23\u0e27\u0e34\u0e40\u0e04\u0e23\u0e32\u0e30\u0e2b\u0e4c\u0e08\u0e32\u0e01 AI"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0e04\u0e33\u0e41\u0e19\u0e30\u0e19\u0e33\u0e08\u0e32\u0e01 AI"
    },
    "language": {
      "type": "string",
      "description": "\u0e20\u0e32\u0e29\u0e32\u0e17\u0e35\u0e48\u0e43\u0e0a\u0e49\u0e17\u0e33\u0e41\u0e1a\u0e1a\u0e1b\u0e23\u0e30\u0e40\u0e21\u0e34\u0e19"
    },
    "age": {
      "type": "number",
      "description": "\u0e2d\u0e32\u0e22\u0e38\u0e1c\u0e39\u0e49\u0e17\u0e33\u0e41\u0e1a\u0e1a\u0e1b\u0e23\u0e30\u0e40\u0e21\u0e34\u0e19"
    },
    "age_group": {
      "type": "string",
      "enum": [
        "under20",
        "over20"
      ],
      "description": "\u0e01\u0e25\u0e38\u0e48\u0e21\u0e2d\u0e32\u0e22\u0e38 \u0e15\u0e48\u0e33\u0e01\u0e27\u0e48\u0e32 20 \u0e2b\u0e23\u0e37\u0e2d\u0e21\u0e32\u0e01\u0e01\u0e27\u0e48\u0e32 20"
    },
    "nationality": {
      "type": "string",
      "enum": [
        "thai",
        "foreigner"
      ],
      "default": "thai",
      "description": "\u0e2a\u0e31\u0e0d\u0e0a\u0e32\u0e15\u0e34 \u0e44\u0e17\u0e22 \u0e2b\u0e23\u0e37\u0e2d \u0e15\u0e48\u0e32\u0e07\u0e0a\u0e32\u0e15\u0e34"
    }
  },
  "required": [
    "risk_level",
    "answers",
    "ai_summary"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
