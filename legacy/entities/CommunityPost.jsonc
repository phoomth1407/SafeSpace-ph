{
  "name": "CommunityPost",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e32\u0e1b\u0e23\u0e30\u0e2a\u0e1a\u0e01\u0e32\u0e23\u0e13\u0e4c\u0e17\u0e35\u0e48\u0e1c\u0e39\u0e49\u0e43\u0e0a\u0e49\u0e40\u0e25\u0e48\u0e32"
    },
    "category": {
      "type": "string",
      "enum": [
        "bullying",
        "family",
        "study",
        "relationship",
        "mental",
        "other"
      ],
      "default": "other",
      "description": "\u0e2b\u0e21\u0e27\u0e14\u0e2b\u0e21\u0e39\u0e48\u0e02\u0e2d\u0e07\u0e1b\u0e23\u0e30\u0e2a\u0e1a\u0e01\u0e32\u0e23\u0e13\u0e4c"
    },
    "ai_response": {
      "type": "string",
      "description": "\u0e04\u0e33\u0e43\u0e2b\u0e49\u0e01\u0e33\u0e25\u0e31\u0e07\u0e43\u0e08/\u0e04\u0e33\u0e41\u0e19\u0e30\u0e19\u0e33\u0e08\u0e32\u0e01 AI"
    },
    "ai_risk_flag": {
      "type": "string",
      "enum": [
        "safe",
        "moderate",
        "high"
      ],
      "default": "safe",
      "description": "\u0e41\u0e1f\u0e25\u0e47\u0e01\u0e04\u0e27\u0e32\u0e21\u0e40\u0e2a\u0e35\u0e48\u0e22\u0e07\u0e17\u0e35\u0e48 AI \u0e15\u0e23\u0e27\u0e08\u0e1e\u0e1a"
    },
    "ai_enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u0e1c\u0e39\u0e49\u0e43\u0e0a\u0e49\u0e40\u0e25\u0e37\u0e2d\u0e01\u0e43\u0e2b\u0e49 AI \u0e15\u0e2d\u0e1a\u0e01\u0e25\u0e31\u0e1a\u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48"
    },
    "hearts": {
      "type": "number",
      "default": 0,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e01\u0e14\u0e43\u0e08"
    },
    "bumps": {
      "type": "number",
      "default": 0,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e14\u0e31\u0e19\u0e42\u0e1e\u0e2a\u0e15\u0e4c"
    },
    "hearted_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u0e23\u0e32\u0e22\u0e0a\u0e37\u0e48\u0e2d user id \u0e17\u0e35\u0e48\u0e01\u0e14\u0e43\u0e08"
    },
    "bumped_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u0e23\u0e32\u0e22\u0e0a\u0e37\u0e48\u0e2d user id \u0e17\u0e35\u0e48\u0e14\u0e31\u0e19\u0e42\u0e1e\u0e2a\u0e15\u0e4c"
    },
    "author_name": {
      "type": "string",
      "default": "anonymous",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e2a\u0e21\u0e21\u0e38\u0e15\u0e34\u0e02\u0e2d\u0e07\u0e1c\u0e39\u0e49\u0e42\u0e1e\u0e2a\u0e15\u0e4c \u0e2b\u0e23\u0e37\u0e2d anonymous"
    },
    "is_announcement": {
      "type": "boolean",
      "default": false,
      "description": "\u0e40\u0e1b\u0e47\u0e19\u0e1b\u0e23\u0e30\u0e01\u0e32\u0e28\u0e08\u0e32\u0e01\u0e41\u0e2d\u0e14\u0e21\u0e34\u0e19\u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48"
    }
  },
  "required": [
    "content",
    "category"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
